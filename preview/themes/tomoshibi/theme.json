  "ambience": {
    "_comment": "per room mood: a looped CC0 engine bed + a synthesized air-conditioning hiss/hum (gain 0..1)",
    "command": {
      "loop": "humLow",
      "loopVol": 0.16,
      "air": 0.05,
      "hum": 0.025
    },
    "hangar": {
      "loop": "humHangar",
      "loopVol": 0.1,
      "air": 0.08,
      "hum": 0.015
    },
    "reactor": {
      "loop": "humReactor",
      "loopVol": 0.2,
      "air": 0.04,
      "hum": 0.05
    }
  },
  "haptics": {
    "_comment": "overrides the engine vibration patterns in this look (ms on/off). Must stay distinct from the code rhythm (120 / 520 ms pulses). notch = one 90-degree step of a dial (a firm, short click).",
    "tick": [
      18
    ],
    "door": [
      22,
      260,
      14
    ],
    "correct": [
      60,
      90,
      60
    ],
    "wrong": [
      70,
      50,
      70,
      50,
      70,
      50,
      70
    ],
    "second": [
      45
    ],
    "thrustOk": [
      120,
      60,
      380
    ],
    "notch": [
      28
    ]
  },
